#usda 1.0
(
    defaultPrim = "PandarQT64"
    doc = "Reusable PandarQT64 RTX LiDAR assembly: sensor profile plus correctly aligned visual CAD."
)

def OmniLidar "PandarQT64" (
    # RTX LiDAR configuration lives directly on this prim, so anything that
    # references this assembly's defaultPrim (drag-and-drop or
    # Lidar.create(usd_path=...)) gets a correctly-configured sensor, not a
    # wrapper shell.
    prepend references = @./Hesai_PandarQT64.usda@</PandarQT64>
)
{
    # Visual-only CAD.  Its local transform aligns the physical CAD base with
    # the sensor coordinate origin; rangeOffsetM in the profile prevents
    # self-returns from this visible enclosure.

    def Xform "VisualOffset"
    {
        double3 xformOp:translate = (0, 0, -0.0504)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "CAD" (
            prepend references = @./pandar_qt64.usdc@
        )
        {
        }
    }
}
